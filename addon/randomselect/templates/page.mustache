{{!
    @template checkmark_randomselect/page

    Layout for the Checkmark random selection page.

    Context variables required for this template:
    * pageintro - Introductory info text.
    * formurl - Form submission URL.
    * sesskey - Session key.
    * actionname - Submit action field name.
    * previewdataname - Hidden preview data field name.
    * sections - Collapsible section definitions.
      Each section may contain filtercriteria or fieldofapplication data.
    * previewtitle - Preview section title.
    * previewhelpicon - Rendered help icon for the preview section.
    * preview - Preview section data.
    * applybuttonlabel - Label for the apply button.
    * applyaction - Apply action value.
    * applybuttonclass - Apply button Bootstrap variant class.
    * applydisabled - Whether the apply button is disabled.
    * createpreviewbuttonlabel - Label for the create preview button.
    * createpreviewaction - Create preview action value.
    * createpreviewbuttonclass - Create preview button Bootstrap variant class.
    * cancelbuttonlabel - Label for the cancel button.
    * cancelurl - URL for the cancel button.

    Example context (json):
    {
        "pageintro": "Here, you can randomly select students for a presentation.",
        "formurl": "/mod/checkmark/addon/randomselect/index.php?id=23",
        "sesskey": "abc123",
        "actionname": "action",
        "previewdataname": "previewdata",
        "sections": [
            {"id": "checkmark-randomselect-filtercriteria", "title": "Filter criteria", "helpicon": ""},
            {
                "id": "checkmark-randomselect-fieldofapplication",
                "title": "Field of application",
                "helpicon": "",
                "fieldofapplication": {
                    "exampleslabel": "Examples from this checkmark activity",
                    "exampleshelpicon": "",
                    "exampleselectionname": "exampleselection",
                    "exampleselectionall": "all",
                    "exampleselectionallid": "checkmark-randomselect-example-selection-all",
                    "exampleselectionselected": "selected",
                    "exampleselectionselectedid": "checkmark-randomselect-example-selection-selected",
                    "alllabel": "All",
                    "selectedlabel": "Selected",
                    "nonelabel": "None",
                    "exampleoptions": [
                        {
                            "id": 42,
                            "label": "Example 1 (10 points)",
                            "inputid": "checkmark-randomselect-example-42",
                            "checked": true
                        }
                    ],
                    "hasexampleoptions": true,
                    "nooptionsmessage": "No examples are available in this Checkmark activity.",
                    "examplesperstudentlabel": "Number of examples per student",
                    "examplesperstudenthelpicon": "",
                    "examplesperstudentname": "examplesperstudent",
                    "examplesperstudentoptions": [
                        {"value": 1, "label": 1, "selected": true}
                    ]
                }
            }
        ],
        "previewtitle": "Preview",
        "previewhelpicon": "",
        "preview": {"haspreview": false},
        "applybuttonlabel": "Apply random selection",
        "applyaction": "apply",
        "applybuttonclass": "btn-secondary",
        "applydisabled": true,
        "createpreviewbuttonlabel": "Create new preview",
        "createpreviewaction": "preview",
        "createpreviewbuttonclass": "btn-primary",
        "cancelbuttonlabel": "Cancel",
        "cancelurl": "/mod/checkmark/view.php?id=23"
    }
}}
<div id="checkmark-randomselect-page" class="checkmark-randomselect-page header-maxwidth mt-4"
     data-region="checkmark-randomselect-page">
    <div class="alert alert-info d-flex align-items-start mb-3" role="status">
        <span class="mr-3" aria-hidden="true">
            <i class="icon fa fa-info-circle fa-fw fa-2x"></i>
        </span>
        <span class="sr-only">{{#str}}info{{/str}}</span>
        <div>{{{pageintro}}}</div>
    </div>

    <form method="post" action="{{formurl}}" data-region="checkmark-randomselect-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="{{previewdataname}}" value="{{preview.previewdata}}">

        <div class="collapsible-actions text-right mb-2">
            <a id="checkmark-randomselect-collapseall" href="#" aria-expanded="false"
               class="btn btn-link p-1 collapseexpand collapsemenu collapsed" role="button">
                <span class="collapseall">{{#str}}collapseall{{/str}}</span>
                <span class="expandall">{{#str}}expandall{{/str}}</span>
            </a>
        </div>

        <div data-region="checkmark-randomselect-collapsible-sections">
            {{#sections}}
                <section class="checkmark-randomselect-section mb-3" data-region="checkmark-randomselect-section">
                    <div class="d-flex align-items-center mb-0">
                        <button type="button" class="btn btn-icon mr-3 icons-collapse-expand justify-content-center collapsed"
                                aria-expanded="false" aria-controls="{{id}}"
                                data-region="checkmark-randomselect-section-toggle">
                            <span class="expanded-icon icon-no-margin p-2" title="{{#str}}collapse, core{{/str}}">
                                {{#pix}} t/expandedchevron, core {{/pix}}
                            </span>
                            <span class="collapsed-icon icon-no-margin p-2" title="{{#str}}expand, core{{/str}}">
                                <span class="dir-rtl-hide">{{#pix}} t/collapsedchevron, core {{/pix}}</span>
                                <span class="dir-ltr-hide">{{#pix}} t/collapsedchevron_rtl, core {{/pix}}</span>
                            </span>
                            <span class="sr-only">{{title}}</span>
                        </button>
                        <h3 class="h5 d-flex align-self-stretch align-items-center mb-0">{{title}}</h3>
                        <span class="ml-1">{{{helpicon}}}</span>
                    </div>
                    <div id="{{id}}" class="collapse mt-3 ml-5"
                         data-region="checkmark-randomselect-section-content">
                        {{#filtercriteria}}
                            {{> checkmark_randomselect/filtercriteria }}
                        {{/filtercriteria}}
                        {{#fieldofapplication}}
                            {{> checkmark_randomselect/fieldofapplication }}
                        {{/fieldofapplication}}
                    </div>
                </section>
            {{/sections}}
        </div>

        <hr class="my-5">

        <section class="checkmark-randomselect-preview" data-region="checkmark-randomselect-preview-section">
            <h3 class="h5 d-flex align-items-center mb-4">
                <span>{{previewtitle}}</span>
                <span class="ml-1">{{{previewhelpicon}}}</span>
            </h3>
            <div data-region="checkmark-randomselect-preview">
                {{#preview}}
                    {{> checkmark_randomselect/preview }}
                {{/preview}}
            </div>
        </section>

        <div class="mt-5">
            <button type="submit" name="{{actionname}}" value="{{applyaction}}"
                    class="btn {{applybuttonclass}} mr-1" data-action="apply-random-selection"
                    {{#applydisabled}}disabled{{/applydisabled}}>
                {{applybuttonlabel}}
            </button>
            <button type="submit" name="{{actionname}}" value="{{createpreviewaction}}"
                    class="btn {{createpreviewbuttonclass}} mr-1" data-action="create-preview">
                {{createpreviewbuttonlabel}}
            </button>
            <a class="btn btn-secondary" href="{{cancelurl}}" role="button" data-action="cancel">
                {{cancelbuttonlabel}}
            </a>
        </div>
    </form>
</div>
